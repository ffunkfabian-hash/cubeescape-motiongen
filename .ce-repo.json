{
  "name": "cubeescape-reference",
  "version": {
    "file": "CHANGELOG.md",
    "pattern": "(?m)^## (\\d+\\.\\d+(?:\\.\\d+)?)"
  },
  "version_name": "Hallmark",
  "check": {
    "quick": [
      [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      [
        "python3",
        "tools/check_links.py"
      ]
    ],
    "nightly": [
      [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      [
        "python3",
        "tools/check_links.py"
      ]
    ]
  },
  "limits": {
    "no_media": true
  },
  "tools_version": {
    "version": "0.45.0",
    "commit": "e5e0eb9591351180f2d451bffdbe5f68fd13f4e0"
  },
  "docs": {
    "changelog": "CHANGELOG.md",
    "agent_sections": [
      "Projekt",
      "Messregeln",
      "Befehle",
      "Definition of Done"
    ]
  },
  "coordination": {
    "repo": "ffunkfabian-hash/cubeescape-nexogen",
    "registry": "https://github.com/ffunkfabian-hash/cubeescape-nexogen/blob/main/repos.json"
  },
  "core_paths": []
}
